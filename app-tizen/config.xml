<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://glordu.tv/GlorduTV" version="0.1.0" viewmodes="maximized">
    <tizen:application id="glordutv01.GlorduTV" package="glordutv01" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>Glordu TV</name>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>

    <!-- Fetch config and images from GitHub Pages and Google's image hosts. -->
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <!-- Receive media and color keys from the remote. -->
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
